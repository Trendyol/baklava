      "response": "<bl-dialog open critical caption=\"Delete this item?\">\n  <p>Are you sure you want to permanently delete this item? This action cannot be undone.</p>\n  <bl-button slot=\"secondary-action\" variant=\"secondary\" label=\"Cancel\"></bl-button>\n  <bl-button slot=\"primary-action\" variant=\"primary\" kind=\"danger\" label=\"Delete\"></bl-button>\n</bl-dialog>\n\n<script>\n  const dialog = document.querySelector('bl-dialog');\n  const [cancelBtn, deleteBtn] = dialog.querySelectorAll('bl-button[slot]');\n\n  cancelBtn?.addEventListener('bl-click', () => { dialog.open = false; });\n\n  deleteBtn?.addEventListener('bl-click', () => {\n    // Delete action placeholder: the item would be removed here.\n    dialog.open = false;\n  });\n\n  // Close via the dialog's built-in backdrop / Escape / close button.\n  dialog?.addEventListener('bl-dialog-request-close', (event) => {\n    // Allow close on cancel/backdrop/Escape; block nothing so users can leave.\n  });\n</script>\n",
