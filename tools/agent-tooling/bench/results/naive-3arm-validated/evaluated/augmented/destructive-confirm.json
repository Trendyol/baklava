      "response": "<bl-dialog id=\"confirmDialog\" open caption=\"Confirm deletion\" critical>\n  <p>This item will be permanently removed. This action cannot be undone.</p>\n  <bl-button slot=\"primary-action\" kind=\"danger\" label=\"Delete item\"></bl-button>\n  <bl-button slot=\"secondary-action\" variant=\"tertiary\" label=\"Cancel\"></bl-button>\n</bl-dialog>\n\n<bl-button id=\"deleteTrigger\" kind=\"danger\" label=\"Delete item\"></bl-button>\n\n<script>\n  const dialog = document.querySelector('#confirmDialog');\n  document.querySelector('#deleteTrigger').addEventListener('bl-click', () => {\n    dialog.setAttribute('open', '');\n  });\n  document.querySelector('[slot=\"secondary-action\"]').addEventListener('bl-click', () => {\n    dialog.removeAttribute('open');\n  });\n  document.querySelector('[slot=\"primary-action\"]').addEventListener('bl-click', () => {\n    dialog.removeAttribute('open');\n  });\n</script>\n",
