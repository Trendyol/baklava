      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Save Confirmation</title>\n    <style>\n      body {\n        font-family: system-ui, sans-serif;\n        margin: 0;\n        padding: 24px;\n        min-height: 100vh;\n        box-sizing: border-box;\n      }\n      .toast-wrapper {\n        position: fixed;\n        top: 16px;\n        right: 16px;\n        z-index: 1000;\n      }\n      .save-btn {\n        padding: 10px 18px;\n        font-size: 14px;\n        border-radius: 6px;\n        border: 1px solid #ccc;\n        background: #2563eb;\n        color: #fff;\n        cursor: pointer;\n      }\n    </style>\n  </head>\n  <body>\n    <button type=\"button\" class=\"save-btn\" id=\"save\">Save</button>\n\n    <div class=\"toast-wrapper\" id=\"toastHost\">\n      <bl-notification open>\n        <bl-notification-card>\n          <span slot=\"icon\">✓</span>\n          <strong>Saved</strong>\n          <p>Your changes were saved successfully.</p>\n          <bl-button slot=\"action\" variant=\"tertiary\" id=\"dismiss\">Dismiss</bl-button>\n        </bl-notification-card>\n      </bl-notification>\n    </div>\n\n    <script>\n      const toast = document.querySelector('bl-notification');\n      const saveBtn = document.getElementById('save');\n      const dismiss = document.getElementById('dismiss');\n\n      function showToast() {\n        toast.setAttribute('open', '');\n      }\n      function hideToast() {\n        toast.removeAttribute('open');\n      }\n\n      saveBtn.addEventListener('click', showToast);\n      dismiss.addEventListener('click', hideToast);\n    </script>\n  </body>\n</html>\n",
