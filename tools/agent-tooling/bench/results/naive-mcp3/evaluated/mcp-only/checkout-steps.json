      "response": "<div class=\"checkout-header\">\n  <div class=\"cart-wrap\">\n    <button type=\"button\" class=\"cart-button\" aria-label=\"Open shopping cart\">\n      <bl-icon name=\"shopping_cart\"></bl-icon>\n      <bl-badge size=\"small\" class=\"cart-count\">2</bl-badge>\n    </button>\n  </div>\n\n  <bl-stepper type=\"number\" direction=\"horizontal\" usage=\"non-clickable\" style=\"max-width: 520px; margin-top: 24px;\">\n    <bl-stepper-item id=\"cart\" title=\"Cart\" description=\"Your items\" variant=\"active\"></bl-stepper-item>\n    <bl-stepper-item id=\"shipping\" title=\"Shipping\" description=\"Delivery address\" variant=\"default\"></bl-stepper-item>\n    <bl-stepper-item id=\"payment\" title=\"Payment\" description=\"Payment method\" variant=\"default\"></bl-stepper-item>\n  </bl-stepper>\n</div>\n\n<style>\n  .checkout-header {\n    font-family: inherit;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 8px;\n    padding: 16px;\n  }\n  .cart-wrap {\n    position: relative;\n    display: inline-flex;\n  }\n  .cart-button {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    padding: 0;\n    border: none;\n    background: transparent;\n    cursor: pointer;\n    color: var(--bl-color-primary, #0053ff);\n  }\n  .cart-count {\n    position: absolute;\n    top: 2px;\n    right: 0;\n    transform: translate(40%, -20%);\n  }\n</style>\n\n<script>\n  // bl-stepper-change is a CustomEvent<string> fired when the active step changes.\n  document.addEventListener('bl-stepper-change', (event) => {\n    const detail = event.detail;\n    console.log('Current checkout step changed to:', detail);\n  });\n  document.querySelector('.cart-button')?.addEventListener('click', () => {\n    console.log('Open shopping cart (2 items)');\n  });\n</script>\n",
