      "sample": 1,
      "response": "<!-- Multi-step checkout indicator with cart badge. Components verified via MCP:\n     bl-stepper (type number|dot|icon, direction, usage), bl-stepper-item (variant default|success|error|active,\n     icon, title, description), bl-badge (size small|medium|large, icon), bl-icon (name). -->\n<div style=\"font-family: var(--bl-font-family, sans-serif); padding: 24px;\">\n\n  <!-- Cart icon with a badge signalling 2 items -->\n  <div style=\"position: relative; display: inline-flex; margin-bottom: 24px;\">\n    <bl-icon name=\"cart\" style=\"font-size: 28px;\"></bl-icon>\n    <bl-badge size=\"small\" style=\"position: absolute; top: -8px; right: -12px;\">2</bl-badge>\n  </div>\n\n  <!-- Checkout progress: cart (current) -> shipping -> payment -->\n  <bl-stepper type=\"dot\" direction=\"horizontal\">\n    <bl-stepper-item id=\"step-cart\" variant=\"active\" title=\"Cart\" description=\"Review items\"></bl-stepper-item>\n    <bl-stepper-item id=\"step-shipping\" variant=\"default\" title=\"Shipping\" description=\"Delivery info\"></bl-stepper-item>\n    <bl-stepper-item id=\"step-payment\" variant=\"default\" title=\"Payment\" description=\"Billing\"></bl-stepper-item>\n  </bl-stepper>\n\n  <script>\n    const stepper = document.querySelector('bl-stepper');\n    if (stepper) {\n      stepper.addEventListener('bl-stepper-change', (event) => {\n        console.log('checkout step:', event.detail && event.detail.activeStep);\n      });\n    }\n  </script>\n</div>\n",
