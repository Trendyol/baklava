      "sample": 1,
      "response": "<form id=\"login-form\" class=\"login-form\" novalidate>\n  <div class=\"login-card\">\n    <h2 class=\"login-title\">Sign in</h2>\n    <p class=\"login-subtitle\">Enter your email and password to continue.</p>\n\n    <bl-input\n      id=\"email\"\n      name=\"email\"\n      label=\"Email address\"\n      type=\"email\"\n      placeholder=\"you@example.com\"\n      autocomplete=\"email\"\n      required\n      icon=\"email\"\n    ></bl-input>\n\n    <bl-input\n      id=\"password\"\n      name=\"password\"\n      label=\"Password\"\n      type=\"password\"\n      placeholder=\"••••••••\"\n      autocomplete=\"current-password\"\n      required\n      icon=\"lock\"\n    ></bl-input>\n\n    <bl-button id=\"submit-btn\" type=\"submit\" size=\"large\" class=\"login-submit\">\n      Sign in\n    </bl-button>\n  </div>\n</form>\n\n<script>\n  const email = document.getElementById('email');\n  const password = document.getElementById('password');\n\n  function validateField(cmp) {\n    const valid = cmp.reportValidity ? cmp.reportValidity() : cmp.checkValidity();\n    if (!valid) {\n      cmp.toggleAttribute('invalid', true);\n    } else {\n      cmp.removeAttribute('invalid');\n    }\n    return valid;\n  }\n\n  function submitLogin(ev) {\n    ev.preventDefault();\n    const okEmail = validateField(email);\n    const okPass = validateField(password);\n    if (!okEmail || !okPass) return;\n    // Submit the credentials (demo: log resolved values).\n    const payload = {\n      email: email.value,\n      password: password.value,\n    };\n    console.log('login submit', payload);\n  }\n\n  document.getElementById('login-form').addEventListener('submit', submitLogin);\n  document.getElementById('submit-btn').addEventListener('bl-click', () => {\n    document.getElementById('login-form').requestSubmit();\n  });\n  email.addEventListener('bl-input', () => email.removeAttribute('invalid'));\n  password.addEventListener('bl-input', () => password.removeAttribute('invalid'));\n</script>\n\n<style>\n  .login-form { display: flex; justify-content: center; padding: 48px 16px; }\n  .login-card { width: 100%; max-width: 380px; display: flex; flex-direction: column; gap: 20px; }\n  .login-title { margin: 0; font-size: 24px; }\n  .login-subtitle { margin: 0 0 8px; color: #666; }\n  .login-submit { width: 100%; }\n</style>\n",
