      "sample": 1,
      "response": "<!-- Login page built with Baklava components (MCP-only arm) -->\n<style>\n  .login-card {\n    max-width: 360px;\n    margin: 48px auto;\n    padding: 24px;\n    border: 1px solid var(--bl-color-border, #ddd);\n    border-radius: 12px;\n    font-family: var(--bl-font-family, 'Inter', system-ui, sans-serif);\n  }\n  .login-card h1 {\n    margin: 0 0 20px;\n    font-size: 1.4rem;\n    font-weight: 600;\n  }\n  .login-field {\n    display: block;\n    margin-bottom: 16px;\n  }\n  .login-submit {\n    display: block;\n    width: 100%;\n    margin-top: 8px;\n  }\n  .login-status {\n    margin-top: 16px;\n    min-height: 1.2em;\n    font-size: 0.85rem;\n    color: var(--bl-color-error, #c0392b);\n  }\n</style>\n<div class=\"login-card\">\n  <h1>Sign in</h1>\n\n  <form id=\"login-form\" novalidate>\n    <label class=\"login-field\">\n      <bl-input\n        name=\"email\"\n        type=\"email\"\n        label=\"Email address\"\n        placeholder=\"you@example.com\"\n        autocomplete=\"email\"\n        required\n      ></bl-input>\n    </label>\n\n    <label class=\"login-field\">\n      <bl-input\n        name=\"password\"\n        type=\"password\"\n        label=\"Password\"\n        placeholder=\"Enter your password\"\n        autocomplete=\"current-password\"\n        required\n      ></bl-input>\n    </label>\n\n    <bl-button\n      class=\"login-submit\"\n      variant=\"primary\"\n      type=\"submit\"\n    >Sign in</bl-button>\n  </form>\n\n  <p class=\"login-status\" role=\"status\" id=\"login-status\"></p>\n</div>\n\n<script>\n  const form = document.getElementById('login-form');\n  const status = document.getElementById('login-status');\n\n  form.addEventListener('submit', (event) => {\n    event.preventDefault();\n    const email = form.querySelector('bl-input[name=\"email\"]');\n    const password = form.querySelector('bl-input[name=\"password\"]');\n    const valid = email.reportValidity && password.reportValidity\n      ? email.reportValidity() && password.reportValidity()\n      : email.value && password.value;\n    if (!valid) {\n      status.textContent = 'Please fill in both fields.';\n      return;\n    }\n    status.textContent = `Signed in as ${email.value}`;\n  });\n</script>\n",
