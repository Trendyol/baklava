      "sample": 2,
      "response": "<!-- mcp-only arm — login-form sample 2. Components/API learned via Baklava MCP server. -->\n<div class=\"login-card\">\n  <h2>Sign in</h2>\n  <p class=\"subtitle\">Enter your credentials to continue.</p>\n\n  <form id=\"login-form\" novalidate>\n    <bl-input\n      type=\"email\"\n      name=\"email\"\n      label=\"Email address\"\n      placeholder=\"you@example.com\"\n      autocomplete=\"email\"\n      required\n    ></bl-input>\n\n    <bl-input\n      type=\"password\"\n      name=\"password\"\n      label=\"Password\"\n      placeholder=\"••••••••\"\n      autocomplete=\"current-password\"\n      required\n    ></bl-input>\n\n    <bl-button type=\"submit\" variant=\"primary\" label=\"Sign in\" class=\"submit-btn\"></bl-button>\n  </form>\n\n  <script>\n    const form = document.getElementById(\"login-form\");\n    const email = form.querySelector('bl-input[name=\"email\"]');\n    const password = form.querySelector('bl-input[name=\"password\"]');\n\n    // Submit on Enter is handled natively by bl-button[type=submit] inside a form.\n    form.addEventListener(\"submit\", (e) => {\n      e.preventDefault();\n      let ok = true;\n      if (!email.value) {\n        email.error = \"Email address is required.\";\n        ok = false;\n      } else if (!email.value.includes(\"@\")) {\n        email.error = \"Enter a valid email address.\";\n        ok = false;\n      } else {\n        email.error = \"\";\n      }\n\n      if (!password.value) {\n        password.error = \"Password is required.\";\n        ok = false;\n      } else {\n        password.error = \"\";\n      }\n\n      if (ok) {\n        // In a real app sign the user in here.\n        console.log(\"Sign in submitted for\", email.value);\n      }\n    });\n  </script>\n\n  <style>\n    .login-card {\n      max-width: 380px;\n      margin: 0 auto;\n      padding: 24px;\n      display: grid;\n      gap: 16px;\n    }\n    .login-card h2 {\n      margin: 0;\n      font: 600 22px/1.3 var(--bl-font-family, sans-serif);\n    }\n    .subtitle {\n      margin: -8px 0 0;\n      color: var(--bl-color-neutral-80, #666);\n    }\n    #login-form {\n      display: grid;\n      gap: 16px;\n    }\n    .submit-btn {\n      margin-top: 4px;\n    }\n  </style>\n</div>\n",
