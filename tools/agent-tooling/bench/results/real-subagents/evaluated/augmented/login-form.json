      "sample": 1,
      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Login</title>\n  <style>\n    body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: #f4f5f7; }\n    .card { width: 100%; max-width: 360px; padding: 28px; background: #fff; border-radius: 12px; box-shadow: 0 6px 24px rgba(0,0,0,.08); }\n    .card h1 { margin: 0 0 4px; font-size: 20px; }\n    .card p { margin: 0 0 20px; color: #6b7280; font-size: 14px; }\n    bl-input { width: 100%; }\n    bl-input + bl-input { margin-top: 16px; }\n    bl-button { width: 100%; margin-top: 24px; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <h1>Sign in</h1>\n    <p>Enter your credentials to continue.</p>\n    <form id=\"login-form\" novalidate onsubmit=\"handleSubmit(event)\">\n      <bl-input\n        name=\"email\"\n        type=\"email\"\n        label=\"Email address\"\n        placeholder=\"you@example.com\"\n        autocomplete=\"email\"\n        required></bl-input>\n\n      <bl-input\n        name=\"password\"\n        type=\"password\"\n        label=\"Password\"\n        placeholder=\"••••••••\"\n        autocomplete=\"current-password\"\n        required></bl-input>\n\n      <bl-button type=\"submit\" variant=\"primary\" label=\"Sign in\"></bl-button>\n    </form>\n  </div>\n\n  <script>\n    function handleSubmit(event) {\n      event.preventDefault();\n      const form = event.target;\n      // Let the browser run native form validation on the required inputs.\n      if (!form.checkValidity()) {\n        form.reportValidity();\n        return;\n      }\n      const data = new FormData(form);\n      // In a real app this would POST /login. Log for the demo.\n      console.log('Signing in with', Object.fromEntries(data.entries()));\n    }\n  </script>\n</body>\n</html>\n",
