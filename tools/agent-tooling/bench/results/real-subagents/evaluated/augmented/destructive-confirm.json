      "sample": 2,
      "response": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Delete project</title>\n  </head>\n  <body style=\"font-family: system-ui, sans-serif; padding: 2rem\">\n    <bl-button id=\"open-delete\">Delete project</bl-button>\n\n    <bl-dialog id=\"delete-dialog\" open caption=\"Delete project?\" critical>\n      <p>This action cannot be undone. The project and all of its data will be permanently deleted.</p>\n      <bl-button slot=\"primary-action\" kind=\"danger\" id=\"confirm-delete\">Delete</bl-button>\n      <bl-button slot=\"secondary-action\" variant=\"secondary\" id=\"cancel-delete\">Cancel</bl-button>\n      <bl-button slot=\"tertiary-action\" variant=\"tertiary\" id=\"close-delete\">Close</bl-button>\n    </bl-dialog>\n\n    <script>\n      const dialog = document.getElementById('delete-dialog');\n      const openBtn = document.getElementById('open-delete');\n      const confirmBtn = document.getElementById('confirm-delete');\n      const cancelBtn = document.getElementById('cancel-delete');\n      const closeBtn = document.getElementById('close-delete');\n\n      openBtn.addEventListener('click', () => {\n        dialog.open = true;\n      });\n      confirmBtn.addEventListener('click', () => {\n        // simulated destructive action\n        dialog.open = false;\n      });\n      cancelBtn.addEventListener('click', () => {\n        dialog.open = false;\n      });\n      closeBtn.addEventListener('click', () => {\n        dialog.open = false;\n      });\n    </script>\n  </body>\n</html>\n",
