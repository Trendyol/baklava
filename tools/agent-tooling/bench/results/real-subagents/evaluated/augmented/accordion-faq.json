      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>FAQ — Baklava accordion</title>\n  <link rel=\"stylesheet\" href=\"https://cdn.trendyol.com/baklava/latest/baklava.css\">\n  <style>\n    body { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; margin: 0; padding: 32px; background: #fff; color: #1f2328; }\n    .page { max-width: 720px; margin: 0 auto; }\n    h1 { font-size: 22px; margin: 0 0 20px; }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <h1>Frequently Asked Questions</h1>\n\n    <bl-accordion-group multiple>\n      <bl-accordion caption=\"How do I reset my password?\">\n        <p>Go to the login page and select “Forgot password”. We will email you a secure reset link that expires in 30 minutes.</p>\n      </bl-accordion>\n\n      <bl-accordion caption=\"How is shipping calculated?\">\n        <p>Shipping is calculated at checkout based on your delivery address and the total weight of the items in your cart.</p>\n      </bl-accordion>\n\n      <bl-accordion caption=\"Can I return an item?\">\n        <p>Yes. You have 14 days from delivery to request a return from your order history. Refunds are issued to the original payment method.</p>\n      </bl-accordion>\n    </bl-accordion-group>\n  </main>\n</body>\n</html>\n",
