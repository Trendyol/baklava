      "response": "<!-- Settings screen: toggles + language dropdown + per-option hint text (built with Baklava bl-* components, MCP-verified) -->\n<section class=\"settings-panel\">\n  <bl-switch>Enable notifications</bl-switch>\n  <p class=\"hint\">Get a notification when something important happens.</p>\n\n  <bl-switch checked>Dark mode</bl-switch>\n  <p class=\"hint\">Use a darker color scheme to reduce eye strain.</p>\n\n  <bl-switch>Email summaries</bl-switch>\n  <p class=\"hint\">Receive a weekly summary of your activity.</p>\n\n  <bl-switch disabled>Auto-save</bl-switch>\n  <p class=\"hint\">This option is currently locked by your administrator.</p>\n\n  <bl-select label=\"Language\" placeholder=\"Choose a language\" value=\"en\">\n    <bl-select-option value=\"en\">English</bl-select-option>\n    <bl-select-option value=\"tr\">Türkçe</bl-select-option>\n    <bl-select-option value=\"de\">Deutsch</bl-select-option>\n    <bl-select-option value=\"fr\">Français</bl-select-option>\n  </bl-select>\n  <p class=\"hint\">Choose the language used across the interface.</p>\n</section>\n\n<script>\n  // Listen to bl-switch-toggle CustomEvents (real Baklava events, confirmed via MCP).\n  document.querySelectorAll('bl-switch').forEach((sw) => {\n    sw.addEventListener('bl-switch-toggle', (e) => {\n      console.log(`Toggled to: ${e.detail ? 'on' : 'off'}`);\n    });\n  });\n  // bl-select fires a CustomEvent on option click; hook in below.\n  document.querySelector('bl-select')?.addEventListener('bl-select-option', (e) => {\n    console.log(`Language selected: ${e.detail}`);\n  });\n</script>\n",
