      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Settings</title>\n</head>\n<body>\n  <form class=\"settings\" id=\"settings\">\n    <h1>Settings</h1>\n\n    <p class=\"hint\">Turn push notifications and reminder alerts on or off.</p>\n    <label class=\"setting\">Notifications<bl-switch name=\"notifications\" checked></bl-switch></label>\n\n    <p class=\"hint\">Receive a short daily summary of your activity.</p>\n    <label class=\"setting\">Daily email summary<bl-switch name=\"email-summary\" checked></bl-switch></label>\n\n    <p class=\"hint\">Allow anonymous usage data to help improve the product.</p>\n    <label class=\"setting\">Usage analytics<bl-switch name=\"analytics\"></bl-switch></label>\n\n    <p class=\"hint\">Enable public profile visibility.</p>\n    <label class=\"setting\">Public profile<bl-switch name=\"public-profile\" checked></bl-switch></label>\n\n    <label class=\"setting\">Interface language</label>\n    <bl-select\n      name=\"language\"\n      label=\"Language\"\n      value=\"en\"\n      help-text=\"Language used for the interface and notifications.\"\n    >\n      <bl-select-option value=\"en\" selected>English</bl-select-option>\n      <bl-select-option value=\"tr\">Türkçe</bl-select-option>\n      <bl-select-option value=\"de\">Deutsch</bl-select-option>\n      <bl-select-option value=\"fr\">Français</bl-select-option>\n    </bl-select>\n\n    <output id=\"out\" aria-live=\"polite\"></output>\n  </form>\n\n  <style>\n    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1f2937; }\n    .settings { max-width: 28rem; display: grid; gap: 1rem; }\n    h1 { font-size: 1.4rem; margin: 0 0 0.5rem; }\n    .setting { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 500; }\n    .hint { margin: 0; font-size: 0.85rem; color: #6b7280; }\n    .hint + .setting { margin-top: 0.35rem; }\n    #out { margin-top: 1rem; font-size: 0.85rem; color: #374151; }\n  </style>\n\n  <script type=\"module\">\n    const output = () => {\n      const switches = [...document.querySelectorAll('.settings bl-switch')];\n      const selected = document.querySelector('.settings bl-select');\n      const lang = selected.selectedOptions?.[0]?.value || selected.value || '';\n      const on = switches.filter((s) => s.checked).map((s) => s.name).join(', ') || 'none';\n      document.getElementById('out').textContent = `Switches on: ${on}. Language: ${lang}.`;\n    };\n\n    document.querySelectorAll('.settings bl-switch').forEach((s) => {\n      s.addEventListener('bl-switch-toggle', output);\n    });\n    document.querySelector('.settings bl-select').addEventListener('bl-select', output);\n    output();\n  </script>\n</body>\n</html>\n",
