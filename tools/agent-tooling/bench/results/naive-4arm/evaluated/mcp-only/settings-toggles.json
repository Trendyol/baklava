      "sample": 1,
      "response": "<section class=\"settings\">\n  <h2>Settings</h2>\n  <p class=\"page-hint\">Adjust your preferences below.</p>\n\n  <div class=\"options\">\n    <label class=\"option-item\">\n      <bl-switch id=\"notifications\"></bl-switch>\n      <span class=\"option-text\">\n        <span class=\"option-title\">Email notifications</span>\n        <span class=\"option-hint\">Get an email for every new message.</span>\n      </span>\n    </label>\n\n    <label class=\"option-item\">\n      <bl-switch id=\"dark-mode\"></bl-switch>\n      <span class=\"option-text\">\n        <span class=\"option-title\">Dark mode</span>\n        <span class=\"option-hint\">Use a dark color scheme across the app.</span>\n      </span>\n    </label>\n\n    <label class=\"option-item\">\n      <bl-switch id=\"autosave\"></bl-switch>\n      <span class=\"option-text\">\n        <span class=\"option-title\">Autosave</span>\n        <span class=\"option-hint\">Save your changes automatically as you type.</span>\n      </span>\n    </label>\n  </div>\n\n  <div class=\"language-row\">\n    <bl-select id=\"language\" label=\"Language\" help-text=\"Choose the language used for the interface.\" placeholder=\"Select a language\">\n      <bl-select-option value=\"en\">English</bl-select-option>\n      <bl-select-option value=\"tr\">Türkçe</bl-select-option>\n      <bl-select-option value=\"de\">Deutsch</bl-select-option>\n      <bl-select-option value=\"fr\">Français</bl-select-option>\n    </bl-select>\n    <span class=\"option-hint language-hint\">The selected language applies to the whole site.</span>\n  </div>\n</section>\n\n<style>\n  .settings {\n    font-family: var(--bl-font-family, sans-serif);\n    max-width: 560px;\n    margin: 0 auto;\n    padding: 24px;\n    color: var(--bl-color-text, #1a2433);\n  }\n  .settings h2 { margin: 0 0 4px; }\n  .page-hint { color: var(--bl-color-text-secondary, #5b6572); margin: 0 0 24px; }\n  .options { display: flex; flex-direction: column; gap: 18px; margin-bottom: 28px; }\n  .option-item { display: flex; align-items: center; gap: 14px; }\n  .option-text { display: flex; flex-direction: column; gap: 2px; }\n  .option-title { font-weight: 600; }\n  .option-hint { font-size: 13px; color: var(--bl-color-text-secondary, #5b6572); }\n  .language-row { display: flex; flex-direction: column; gap: 6px; max-width: 280px; }\n  .language-hint { margin: 0; }\n</style>\n\n<script type=\"module\">\n  const switches = document.querySelectorAll('bl-switch');\n  for (const el of switches) {\n    el.addEventListener('bl-switch-toggle', (e) => {\n      console.log(`${el.id} -> ${e.detail}`);\n    });\n  }\n\n  const language = document.querySelector('#language');\n  if (language) {\n    language.addEventListener('bl-select', (e) => {\n      console.log(`language changed -> ${e.detail}`);\n    });\n  }\n</script>\n",
