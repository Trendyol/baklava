      "response": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Settings</title>\n  </head>\n  <body>\n    <ul class=\"settings-list\">\n      <li>\n        <bl-switch checked>Email notifications</bl-switch>\n        <p class=\"hint\">Send updates about your account activity.</p>\n      </li>\n      <li>\n        <bl-switch>Weekly digest</bl-switch>\n        <p class=\"hint\">A summary of new features every Monday.</p>\n      </li>\n      <li>\n        <bl-switch>Two-factor authentication</bl-switch>\n        <p class=\"hint\">Add an extra security layer when signing in.</p>\n      </li>\n      <li>\n        <bl-select label=\"Language\" help-text=\"Choose your preferred language.\" placeholder=\"Select a language\">\n          <bl-select-option value=\"en\" label=\"English\">English</bl-select-option>\n          <bl-select-option value=\"tr\" label=\"Türkçe\">Türkçe</bl-select-option>\n          <bl-select-option value=\"de\" label=\"Deutsch\">Deutsch</bl-select-option>\n        </bl-select>\n      </li>\n    </ul>\n\n    <script>\n      const switches = document.querySelectorAll('bl-switch');\n      switches.forEach((s) => {\n        s.addEventListener('bl-switch-toggle', (e) => {\n          const name = s.textContent.trim();\n          s.setAttribute('data-state', e.detail.toString());\n        });\n      });\n      const select = document.querySelector('bl-select');\n      select.addEventListener('bl-blur', (e) => {\n        select.setAttribute('data-language', String(e.detail ?? ''));\n      });\n    </script>\n  </body>\n</html>\n",
