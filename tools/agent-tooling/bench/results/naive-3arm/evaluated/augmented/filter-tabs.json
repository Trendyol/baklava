      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Filter Tabs</title>\n  <script type=\"module\" src=\"/dist/baklava.js\"></script>\n  <style>\n    body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #1f2430; }\n    .stack { display: grid; gap: 1.5rem; }\n    bl-tab-panel { padding: 1rem 0; }\n  </style>\n</head>\n<body>\n  <main class=\"stack\">\n    <h1>Product Views</h1>\n\n    <!-- Real Baklava tabs: bl-tab in the \"tabs\" slot, bl-tab-panel in the default slot -->\n    <bl-tab-group aria-label=\"Switch between product views\">\n      <bl-tab slot=\"tabs\" name=\"overview\" caption=\"Overview\"></bl-tab>\n      <bl-tab slot=\"tabs\" name=\"details\" caption=\"Details\" selected></bl-tab>\n      <bl-tab slot=\"tabs\" name=\"related\" caption=\"Related\"></bl-tab>\n\n      <bl-tab-panel tab=\"overview\">\n        <p>Overview panel content: key product information is summarized here.</p>\n      </bl-tab-panel>\n      <bl-tab-panel tab=\"details\">\n        <ul>\n          <li>Technical specifications</li>\n          <li>Compatibility notes</li>\n          <li>Available variants</li>\n        </ul>\n      </bl-tab-panel>\n      <bl-tab-panel tab=\"related\">\n        <p>Related products live in this panel.</p>\n      </bl-tab-panel>\n    </bl-tab-group>\n\n    <!-- Small icon button with a real Baklava tooltip (trigger via slot) -->\n    <bl-tooltip placement=\"top\">\n      Open settings\n      <bl-button\n        slot=\"tooltip-trigger\"\n        variant=\"tertiary\"\n        size=\"small\"\n        icon=\"settings\"\n        label=\"Settings\"\n      ></bl-button>\n    </bl-tooltip>\n  </main>\n</body>\n</html>\n",
