      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Save confirmation toast</title>\n  <style>\n    body { font-family: system-ui, sans-serif; padding: 2rem; }\n    bl-notification { position: fixed; inset-inline-end: 1rem; inset-block-start: 1rem; z-index: 1000; }\n  </style>\n</head>\n<body>\n  <h1>Save confirmation</h1>\n  <bl-button id=\"save\" variant=\"primary\">Save</bl-button>\n\n  <bl-notification id=\"notifications\"></bl-notification>\n\n  <script type=\"module\">\n    const notify = document.getElementById('notifications');\n    const save = document.getElementById('save');\n\n    const showSaved = () => {\n      notify.addNotification({\n        caption: 'Your changes were saved successfully.',\n        duration: 5,\n        variant: 'success',\n      });\n    };\n\n    save.addEventListener('click', showSaved);\n    // Also surface a confirmation on first load to demonstrate the toast.\n    showSaved();\n  </script>\n</body>\n</html>\n",
