      "sample": 1,
      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Delete confirmation — destructive-confirm (naive baseline)</title>\n  <style>\n    /* minimal page styling so the dialog is centered and the background is dimmed */\n    body {\n      margin: 0;\n      font-family: system-ui, sans-serif;\n      color: #263238;\n      background: #f5f7fa;\n    }\n    .backdrop {\n      position: fixed;\n      inset: 0;\n      background: rgba(13, 27, 42, 0.55);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 10;\n    }\n  </style>\n</head>\n<body>\n  <!-- Demo trigger: in a real app this would be a delete action -->\n  <button id=\"open\" style=\"margin:2rem\">Delete item</button>\n\n  <!-- Confirmation popup that blocks the background -->\n  <div class=\"backdrop\">\n    <bl-dialog open caption=\"Delete this item?\" description=\"This action cannot be undone. The item will be permanently removed.\">\n      <p>Are you sure you want to permanently delete this item?</p>\n      <bl-button class=\"confirm danger\" kind=\"danger\">Delete</bl-button>\n      <bl-button class=\"cancel\" kind=\"neutral\">Cancel</bl-button>\n    </bl-dialog>\n  </div>\n\n  <script>\n    // keep the dialog centered and let the cancel button close it\n    document.getElementById('open').addEventListener('click', () => {\n      const dlg = document.querySelector('bl-dialog');\n      if (dlg) dlg.open = true;\n    });\n    const cancel = document.querySelector('.cancel');\n    if (cancel) {\n      cancel.addEventListener('click', () => {\n        const dlg = document.querySelector('bl-dialog');\n        if (dlg) dlg.open = false;\n      });\n    }\n  </script>\n</body>\n</html>\n",
