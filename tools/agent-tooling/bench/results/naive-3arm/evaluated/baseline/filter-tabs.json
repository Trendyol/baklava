      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Product Views</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      margin: 2rem auto;\n      max-width: 720px;\n      padding: 0 1rem;\n    }\n    .toolbar {\n      display: flex;\n      align-items: center;\n      gap: 0.75rem;\n      margin-top: 1rem;\n    }\n    .spacer { flex: 1; }\n  </style>\n</head>\n<body>\n  <h1>Product Views</h1>\n\n  <bl-tab-group>\n    <bl-tab slot=\"nav\" panel=\"overview\">Overview</bl-tab>\n    <bl-tab slot=\"nav\" panel=\"details\">Details</bl-tab>\n    <bl-tab slot=\"nav\" panel=\"reviews\">Reviews</bl-tab>\n\n    <bl-tab-panel name=\"overview\">\n      <h2>Overview</h2>\n      <p>High-level summary of the product and its key specs.</p>\n    </bl-tab-panel>\n\n    <bl-tab-panel name=\"details\">\n      <h2>Details</h2>\n      <p>Full technical specification of the product.</p>\n    </bl-tab-panel>\n\n    <bl-tab-panel name=\"reviews\">\n      <h2>Reviews</h2>\n      <p>Customer reviews for the product.</p>\n    </bl-tab-panel>\n  </bl-tab-group>\n\n  <div class=\"toolbar\">\n    <span class=\"spacer\"></span>\n    <bl-button\n      id=\"helpBtn\"\n      icon=\"question\"\n      aria-label=\"Help\"\n      variant=\"primary\"\n      kind=\"default\"\n    ></bl-button>\n    <bl-tooltip for=\"helpBtn\">Need a hand? Open the help guide.</bl-tooltip>\n  </div>\n</body>\n</html>\n",
