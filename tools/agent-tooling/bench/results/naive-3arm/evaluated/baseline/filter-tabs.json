      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Product Views</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      margin: 2rem;\n      color: #1c1c1c;\n    }\n    .page-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 1.5rem;\n    }\n    .page-header h1 {\n      font-size: 1.4rem;\n      margin: 0;\n    }\n    .panel p {\n      margin: 0.5rem 0;\n      line-height: 1.6;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-header\">\n    <h1>Catalog</h1>\n    <!-- small icon button with a tooltip explaining what it does -->\n    <bl-button icon=\"info\" aria-label=\"About this view\"></bl-button>\n    <bl-tooltip>\n      <span slot=\"content\">Shows information about the current view.</span>\n    </bl-tooltip>\n  </div>\n\n  <bl-tab-group>\n    <bl-tab id=\"tab-overview\" panel=\"panel-overview\" active>Overview</bl-tab>\n    <bl-tab id=\"tab-grid\" panel=\"panel-grid\">Grid</bl-tab>\n    <bl-tab id=\"tab-list\" panel=\"panel-list\">List</bl-tab>\n\n    <bl-tab-panel name=\"panel-overview\">\n      <div class=\"panel\">\n        <p>Here is a quick overview of your products, sales, and recent activity.</p>\n        <p>Overview panels summarize the most important numbers for you.</p>\n      </div>\n    </bl-tab-panel>\n    <bl-tab-panel name=\"panel-grid\">\n      <div class=\"panel\">\n        <p>Grid view shows products laid out in a responsive grid.</p>\n        <p>Each card displays the product image, title, and price.</p>\n      </div>\n    </bl-tab-panel>\n    <bl-tab-panel name=\"panel-list\">\n      <div class=\"panel\">\n        <p>List view shows products as rows with columns for name, stock, and price.</p>\n        <p>You can sort and filter from this view.</p>\n      </div>\n    </bl-tab-panel>\n  </bl-tab-group>\n\n  <script type=\"module\">\n    const tabGroup = document.querySelector('bl-tab-group');\n    const tabs = Array.from(tabGroup.querySelectorAll('bl-tab'));\n    tabs.forEach((tab) => {\n      tab.addEventListener('click', () => {\n        tabs.forEach((t) => t.removeAttribute('active'));\n        tab.setAttribute('active', '');\n      });\n    });\n  </script>\n</body>\n</html>\n",
