      "sample": 1,
      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Delete confirmation</title>\n  <script type=\"module\" src=\"/src/baklava.js\"></script>\n  <style>\n    body { font-family: system-ui, sans-serif; padding: 2rem; display: grid; gap: 1rem; place-items: center; }\n  </style>\n</head>\n<body>\n  <bl-button id=\"open-delete\" kind=\"danger\" label=\"Delete account\"></bl-button>\n\n  <bl-dialog id=\"confirm-dialog\" caption=\"Delete account?\" critical>\n    <p>This action cannot be undone. The account and all of its data will be permanently removed.</p>\n    <div slot=\"primary-action\">\n      <bl-button id=\"confirm-delete\" kind=\"danger\" label=\"Delete\" type=\"submit\"></bl-button>\n    </div>\n    <div slot=\"secondary-action\">\n      <bl-button id=\"cancel-delete\" kind=\"neutral\" label=\"Cancel\"></bl-button>\n    </div>\n  </bl-dialog>\n\n  <script>\n    const dialog = document.getElementById('confirm-dialog');\n    const confirmBtn = document.getElementById('confirm-delete');\n    const cancelBtn = document.getElementById('cancel-delete');\n\n    // Open the modal, blocking the background.\n    document.getElementById('open-delete').addEventListener('bl-click', () => {\n      dialog.setAttribute('open', '');\n    });\n\n    // Dangerous confirmation button.\n    confirmBtn.addEventListener('bl-click', () => {\n      // In a real app this would call the delete API.\n      console.log('DELETE confirmed');\n      dialog.removeAttribute('open');\n    });\n\n    // Safe cancel button.\n    cancelBtn.addEventListener('bl-click', () => {\n      dialog.removeAttribute('open');\n    });\n  </script>\n</body>\n</html>\n",
