      "sample": 2,
      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Delete confirmation</title>\n  <style>\n    body {\n      font-family: sans-serif;\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n    }\n    .card {\n      padding: 24px 28px;\n      border: 1px solid #e2e5ea;\n      border-radius: 12px;\n      max-width: 420px;\n      text-align: center;\n    }\n    .card h2 { margin-top: 0; }\n  </style>\n</head>\n<body class=\"bl-theme-light\">\n  <!-- A page card offering a delete action that opens the destructive dialog -->\n  <div class=\"card\">\n    <h2>Account settings</h2>\n    <p>You can remove this project. This action cannot be undone.</p>\n    <bl-button variant=\"primary\" kind=\"danger\" id=\"open-delete\">Delete project</bl-button>\n  </div>\n\n  <!-- Destructive confirmation dialog: blocks background, asks for confirmation -->\n  <bl-dialog open caption=\"Delete project?\" critical>\n    <p>\n      This will permanently delete the project and all of its data. This action\n      cannot be undone.\n    </p>\n    <bl-button slot=\"secondary-action\" variant=\"primary\" kind=\"neutral\" id=\"cancel-delete\">\n      Cancel\n    </bl-button>\n    <bl-button slot=\"primary-action\" variant=\"primary\" kind=\"danger\" id=\"confirm-delete\">\n      Delete\n    </bl-button>\n  </bl-dialog>\n\n  <script>\n    const dialog = document.querySelector('bl-dialog');\n    const openBtn = document.getElementById('open-delete');\n\n    // Re-open the dialog (it starts open; wire the trigger for a fresh open too)\n    openBtn.addEventListener('bl-click', () => {\n      dialog.open = true;\n    });\n\n    // Cancel: request close with the safe button\n    document.getElementById('cancel-delete').addEventListener('bl-click', () => {\n      dialog.open = false;\n    });\n\n    // Confirm: log the destructive action, then close\n    document.getElementById('confirm-delete').addEventListener('bl-click', () => {\n      console.log('Project deleted (destructive action confirmed).');\n      dialog.open = false;\n    });\n\n    // Escape / backdrop / close-button all route through request-close;\n    // allow it so the dialog closes.\n    dialog.addEventListener('bl-dialog-request-close', (event) => {\n      event.preventDefault();\n      dialog.open = false;\n    });\n  </script>\n</body>\n</html>\n",
