      "sample": 1,
      "response": "<!-- Destructive delete confirmation dialog using Baklava bl-dialog + bl-button -->\n<header style=\"padding: 24px;\">\n  <h2 style=\"margin-top: 0;\">Delete confirmation (mcp-only)</h2>\n  <bl-button id=\"open-delete\" variant=\"primary\" kind=\"danger\" icon=\"trash\">Delete item</bl-button>\n</header>\n\n<bl-dialog id=\"delete-dialog\" open critical caption=\"Delete this item?\">\n  <p style=\"margin: 0;\">\n    This action cannot be undone. The selected item and everything inside it will be\n    permanently removed from your workspace.\n  </p>\n  <bl-button\n    slot=\"secondary-action\"\n    id=\"cancel-delete\"\n    variant=\"secondary\"\n    label=\"Cancel\"\n  ></bl-button>\n  <bl-button\n    slot=\"primary-action\"\n    id=\"confirm-delete\"\n    variant=\"primary\"\n    kind=\"danger\"\n    icon=\"trash\"\n    label=\"Delete\"\n  ></bl-button>\n</bl-dialog>\n\n<script type=\"module\">\n  const dialog = document.getElementById('delete-dialog');\n  const openBtn = document.getElementById('open-delete');\n  const cancelBtn = document.getElementById('cancel-delete');\n  const confirmBtn = document.getElementById('confirm-delete');\n\n  // Close the dialog when the user cancels via the Cancel button.\n  cancelBtn.addEventListener('bl-click', () => {\n    dialog.closeDialog();\n  });\n\n  // Close the dialog when the user dismisses it (close button, Escape, backdrop).\n  dialog.addEventListener('bl-dialog-close', () => {\n    dialog.open = false;\n  });\n\n  // Let the user reopen it.\n  openBtn.addEventListener('bl-click', () => {\n    dialog.open = true;\n  });\n\n  // Dangerous action: confirm deletion, then close the dialog.\n  confirmBtn.addEventListener('bl-click', () => {\n    alert('Item deleted.');\n    dialog.closeDialog();\n  });\n</script>\n",
