    {
      "sample": 2,
      "response": "<!-- Success notification toast with dismiss (MCP-only arm sample 2) -->\n\n<!-- Baklava styles -->\n<link\n  rel=\"stylesheet\"\n  href=\"https://cdn.jsdelivr.net/npm/@trendyol/baklava/dist/baklava.css\"\n/>\n\n<div class=\"page\">\n  <bl-button id=\"save-btn\" variant=\"primary\">Save</bl-button>\n</div>\n\n<!-- Toast host: renders stacked notification cards in the corner -->\n<bl-notification id=\"toasts\" no-animation></bl-notification>\n\n<script type=\"module\">\n  import { BaklavaIcon } from \"https://cdn.jsdelivr.net/npm/@trendyol/baklava/dist/baklava.esm.js\";\n\n  const toasts = document.getElementById(\"toasts\");\n  const saveBtn = document.getElementById(\"save-btn\");\n\n  function showSaved() {\n    toasts.addNotification({\n      caption: \"Saved\",\n      description: \"Your changes have been saved successfully.\",\n      icon: BaklavaIcon.CheckCircle,\n      variant: \"success\",\n      // Automatically dismisses after 5 seconds, but the close button always works\n      duration: 5\n    });\n  }\n\n  saveBtn.addEventListener(\"bl-click\", showSaved);\n</script>\n\n<style>\n  .page {\n    padding: 24px;\n    font-family: system-ui, sans-serif;\n  }\n</style>\n",
