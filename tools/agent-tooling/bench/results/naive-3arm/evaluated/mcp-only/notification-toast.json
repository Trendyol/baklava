      "sample": 1,
      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Save notification toast</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <style>\n    body {\n      font-family: 'Inter', system-ui, sans-serif;\n      margin: 0;\n      min-height: 100vh;\n      background: #f5f6f8;\n      display: grid;\n      place-items: center;\n    }\n    .demo {\n      background: #fff;\n      border: 1px solid #e5e8ee;\n      border-radius: 12px;\n      padding: 40px;\n      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n      display: flex;\n      align-items: center;\n      gap: 16px;\n    }\n    bl-notification {\n      position: fixed;\n      top: 24px;\n      right: 24px;\n      z-index: 999;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"demo\">\n    <span>Settings were edited</span>\n    <bl-button variant=\"primary\" id=\"save-btn\">Save changes</bl-button>\n  </div>\n\n  <bl-notification id=\"notifications\" no-animation></bl-notification>\n\n  <script type=\"module\">\n    const saveBtn = document.getElementById('save-btn');\n    const notifications = document.getElementById('notifications');\n\n    saveBtn.addEventListener('bl-click', () => {\n      notifications.addNotification({\n        caption: 'Your changes have been saved successfully.',\n        variant: 'success',\n        permanent: false,\n        duration: 7,\n        icon: 'check',\n      });\n    });\n  </script>\n</body>\n</html>\n",
