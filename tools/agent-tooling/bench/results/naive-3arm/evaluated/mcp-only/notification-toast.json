      "sample": 1,
      "response": "<!-- Baklava notification toast — saved confirmation shown in a corner, dismissible -->\n<style>\n  .toast-corner {\n    position: fixed;\n    right: 1.5rem;\n    bottom: 1.5rem;\n    z-index: 1000;\n  }\n  .toast-corner[hidden] { display: none; }\n</style>\n\n<bl-button id=\"saveBtn\" kind=\"success\">Save changes</bl-button>\n\n<bl-notification class=\"toast-corner\">\n  <bl-notification-card\n    id=\"note\"\n    variant=\"success\"\n    permanent\n    caption=\"Saved successfully — your changes are now live.\"\n    icon\n  >\n    <bl-button slot=\"action\" size=\"small\" kind=\"danger\" id=\"dismissBtn\">Dismiss</bl-button>\n  </bl-notification-card>\n</bl-notification>\n\n<script>\n  const corner = document.querySelector('.toast-corner');\n  const note = document.getElementById('note');\n  const saveBtn = document.getElementById('saveBtn');\n  const dismissBtn = document.getElementById('dismissBtn');\n\n  // Show the confirmation toast in the corner after saving.\n  saveBtn.addEventListener('bl-click', () => {\n    corner.hidden = false;\n  });\n\n  // Dismiss via the slot action button (calls the card's close()).\n  dismissBtn.addEventListener('bl-click', () => {\n    note.close();\n  });\n\n  // Hide the corner when the card reports it closed.\n  note.addEventListener('bl-notification-card-close', () => {\n    corner.hidden = true;\n  });\n</script>\n",
