      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>FAQ</title>\n<style>\n  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 52rem; padding: 0 1rem; color: #222; }\n  h1 { font-size: 1.4rem; }\n  .faq { display: flex; flex-direction: column; gap: 0.5rem; }\n  .accordion-item { border: 1px solid #ddd; border-radius: 0.5rem; overflow: hidden; }\n  .accordion-header { margin: 0; }\n  .accordion-button {\n    width: 100%;\n    background: #f4f4f6;\n    border: 0;\n    text-align: left;\n    padding: 0.9rem 1rem;\n    font-size: 1rem;\n    font-weight: 600;\n    cursor: pointer;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n  .accordion-button:hover { background: #ececf0; }\n  .accordion-button .chev { transition: transform .2s ease; }\n  .accordion-item[data-open=\"true\"] .chev { transform: rotate(180deg); }\n  .accordion-collapse {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height .25s ease;\n  }\n  .accordion-body { padding: 0.9rem 1rem; color: #444; }\n</style>\n</head>\n<body>\n  <h1>Frequently Asked Questions</h1>\n  <div class=\"faq\" id=\"faq\">\n\n    <div class=\"accordion-item\" data-open=\"false\">\n      <h2 class=\"accordion-header\">\n        <button type=\"button\" class=\"accordion-button\" aria-expanded=\"false\">\n          What is Baklava?\n          <span class=\"chev\" aria-hidden=\"true\">&#9660;</span>\n        </button>\n      </h2>\n      <div class=\"accordion-collapse\">\n        <div class=\"accordion-body\">\n          Baklava is a Web Components design system built on <code>bl-*</code> custom elements that\n          help you ship consistent, accessible UI.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item\" data-open=\"false\">\n      <h2 class=\"accordion-header\">\n        <button type=\"button\" class=\"accordion-button\" aria-expanded=\"false\">\n          How do I install it?\n          <span class=\"chev\" aria-hidden=\"true\">&#9660;</span>\n        </button>\n      </h2>\n      <div class=\"accordion-collapse\">\n        <div class=\"accordion-body\">\n          Install the package from Trendyol's registry and include the bundle on your page, then\n          use the <code>bl-*</code> tags anywhere in your markup.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"accordion-item\" data-open=\"false\">\n      <h2 class=\"accordion-header\">\n        <button type=\"button\" class=\"accordion-button\" aria-expanded=\"false\">\n          Are components accessible by default?\n          <span class=\"chev\" aria-hidden=\"true\">&#9660;</span>\n        </button>\n      </h2>\n      <div class=\"accordion-collapse\">\n        <div class=\"accordion-body\">\n          Yes — components ship with built-in ARIA semantics, keyboard navigation and focus\n          management so you don't have to wire them up yourself.\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <script>\n    (function () {\n      var items = document.querySelectorAll('.accordion-item');\n      items.forEach(function (item) {\n        var btn = item.querySelector('.accordion-button');\n        var collapse = item.querySelector('.accordion-collapse');\n        btn.addEventListener('click', function () {\n          var open = item.getAttribute('data-open') === 'true';\n          // close all, then open the clicked one\n          items.forEach(function (it) {\n            var panel = it.querySelector('.accordion-collapse');\n            var b = it.querySelector('.accordion-button');\n            it.setAttribute('data-open', 'false');\n            b.setAttribute('aria-expanded', 'false');\n            panel.style.maxHeight = '0';\n          });\n          if (!open) {\n            item.setAttribute('data-open', 'true');\n            btn.setAttribute('aria-expanded', 'true');\n            collapse.style.maxHeight = collapse.scrollHeight + 'px';\n          }\n        });\n      });\n    })();\n  </script>\n</body>\n</html>\n",
