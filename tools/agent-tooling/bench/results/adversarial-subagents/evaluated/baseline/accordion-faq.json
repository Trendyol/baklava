      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>FAQ — Accordion</title>\n  <style>\n    body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 44rem; padding: 0 1rem; color: #1c1c1c; }\n    h1 { font-size: 1.5rem; }\n    .faq-group { margin-top: 1rem; }\n  </style>\n</head>\n<body>\n  <h1>Frequently Asked Questions</h1>\n\n  <div class=\"faq-group\">\n    <bl-accordion-item open>\n      <h2 slot=\"summary\">How do I reset my password?</h2>\n      <p>Click \"Forgot password\" on the login screen and follow the email link to set a new one.</p>\n    </bl-accordion-item>\n\n    <bl-accordion-item>\n      <h2 slot=\"summary\">Can I use Baklava with React?</h2>\n      <p>Yes. You can wrap the bl-* custom elements in React components or use them directly in JSX.</p>\n    </bl-accordion-item>\n\n    <bl-accordion-item>\n      <h2 slot=\"summary\">Is there a free tier?</h2>\n      <p>We offer a free tier with core features. Paid plans unlock advanced tooling and support.</p>\n    </bl-accordion-item>\n  </div>\n\n  <script>\n    // Expand/collapse each item on click of its summary.\n    document.querySelectorAll('bl-accordion-item').forEach(function (item) {\n      const summary = item.querySelector('[slot=\"summary\"]');\n      if (summary) {\n        summary.addEventListener('click', function () {\n          item.toggleAttribute('open', !item.hasAttribute('open'));\n        });\n      }\n    });\n  </script>\n</body>\n</html>\n",
