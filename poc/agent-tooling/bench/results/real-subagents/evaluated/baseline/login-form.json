      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Sign in</title>\n  <style>\n    body { font-family: system-ui, sans-serif; margin: 0; background: #f5f6f8; }\n    .login-shell { display: flex; justify-content: center; padding: 64px 16px; }\n    .login-card { background: #fff; border: 1px solid #e4e6eb; border-radius: 12px; padding: 32px; width: 100%; max-width: 380px; box-shadow: 0 4px 16px rgba(0,0,0,.06); }\n    .login-card h1 { margin: 0 0 4px; font-size: 22px; }\n    .login-card p.sub { margin: 0 0 24px; color: #5f6368; font-size: 14px; }\n    .field { margin-bottom: 16px; }\n    .field label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; }\n    .field bl-input { width: 100%; }\n    .login-actions { margin-top: 24px; }\n    .login-actions bl-button { width: 100%; }\n  </style>\n</head>\n<body>\n  <div class=\"login-shell\">\n    <div class=\"login-card\">\n      <h1>Welcome back</h1>\n      <p class=\"sub\">Enter your details to sign in to your account.</p>\n\n      <form id=\"login\" novalidate>\n        <div class=\"field\">\n          <label for=\"email\">Email address</label>\n          <bl-input id=\"email\" type=\"email\" placeholder=\"you@example.com\" required></bl-input>\n        </div>\n        <div class=\"field\">\n          <label for=\"password\">Password</label>\n          <bl-input id=\"password\" type=\"password\" placeholder=\"Your password\" required></bl-input>\n        </div>\n        <div class=\"login-actions\">\n          <bl-button type=\"submit\" variant=\"primary\">Sign in</bl-button>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <script>\n    const form = document.getElementById('login');\n    const email = document.getElementById('email');\n    const password = document.getElementById('password');\n\n    function submitLogin() {\n      if (!email.value || !password.value) {\n        email.invalid = !email.value;\n        password.invalid = !password.value;\n        return;\n      }\n      // demo only: in a real app this posts to the auth endpoint\n      console.log('submitting login for', email.value);\n    }\n\n    form.addEventListener('submit', (e) => {\n      e.preventDefault();\n      submitLogin();\n    });\n  </script>\n</body>\n</html>\n",
