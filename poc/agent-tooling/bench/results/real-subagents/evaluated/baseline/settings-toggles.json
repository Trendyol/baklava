      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Settings</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      max-width: 560px;\n      margin: 40px auto;\n      padding: 0 16px;\n      color: #1f2430;\n    }\n    h1 { font-size: 22px; margin-bottom: 4px; }\n    .section {\n      border: 1px solid #e4e7ee;\n      border-radius: 10px;\n      padding: 16px;\n      margin-top: 20px;\n    }\n    .row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 10px 0;\n      border-bottom: 1px solid #f0f2f6;\n    }\n    .row:last-child { border-bottom: none; }\n    .row-label { display: flex; flex-direction: column; }\n    .row-label strong { font-size: 15px; }\n    .hint { font-size: 13px; color: #6b7180; margin-top: 2px; }\n    .language {\n      margin-top: 20px;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n    .language label { font-size: 15px; font-weight: 600; }\n    bl-select { max-width: 260px; }\n  </style>\n</head>\n<body>\n  <h1>Settings</h1>\n\n  <section class=\"section\">\n    <div class=\"row\">\n      <div class=\"row-label\">\n        <strong>Email notifications</strong>\n        <span class=\"hint\">Receive emails about account activity.</span>\n      </div>\n      <bl-switch check>true</bl-switch>\n    </div>\n\n    <div class=\"row\">\n      <div class=\"row-label\">\n        <strong>Sound effects</strong>\n        <span class=\"hint\">Play sounds for actions and alerts.</span>\n      </div>\n      <bl-switch>false</bl-switch>\n    </div>\n\n    <div class=\"row\">\n      <div class=\"row-label\">\n        <strong>Autosave</strong>\n        <span class=\"hint\">Save your changes automatically as you type.</span>\n      </div>\n      <bl-switch check>true</bl-switch>\n    </div>\n\n    <div class=\"row\">\n      <div class=\"row-label\">\n        <strong>Dark theme</strong>\n        <span class=\"hint\">Use a dark color scheme across the app.</span>\n      </div>\n      <bl-switch>false</bl-switch>\n    </div>\n  </section>\n\n  <div class=\"language\">\n    <label for=\"lang\">Language</label>\n    <bl-select id=\"lang\" value=\"en\">\n      <bl-select-option value=\"en\">English</bl-select-option>\n      <bl-select-option value=\"tr\">Türkçe</bl-select-option>\n      <bl-select-option value=\"de\">Deutsch</bl-select-option>\n      <bl-select-option value=\"fr\">Français</bl-select-option>\n    </bl-select>\n    <span class=\"hint\">The language used throughout the interface.</span>\n  </div>\n</body>\n</html>\n",
