      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <title>Save Notification Toast</title>\n  <style>\n    :root { font-family: system-ui, sans-serif; }\n    body { padding: 24px; }\n    .stack { max-width: 360px; margin-bottom: 16px; }\n  </style>\n</head>\n<body>\n  <my-toast id=\"saveToast\" type=\"success\">\n    <span slot=\"header\">Saved</span>\n    <p>Your changes have been saved successfully.</p>\n  </my-toast>\n\n  <my-button variant=\"primary\" onclick=\"document.getElementById('saveToast').show()\">\n    Save\n  </my-button>\n\n  <script>\n    customElements.define('my-toast', class extends HTMLElement {\n      connectedCallback() {\n        const type = this.getAttribute('type') || 'success';\n        this.innerHTML = `\n          <div class=\"toast\">\n            <div class=\"toast-header\">\n              <strong>${this.querySelector('[slot=header]')?.textContent || 'Notification'}</strong>\n              <button class=\"close\" aria-label=\"Close\" type=\"button\">×</button>\n            </div>\n            <div class=\"toast-body\"></div>\n          </div>\n        `;\n        const body = this.querySelector('.toast-body');\n        body.appendChild(this.querySelector('p'));\n        this.querySelector('.close').addEventListener('click', () => this.hide());\n        this.hidden = true;\n      }\n      show() { this.hidden = false; }\n      hide() { this.hidden = true; }\n    });\n\n    customElements.define('my-button', class extends HTMLElement {\n      connectedCallback() {\n        this.setAttribute('role', 'button');\n        this.setAttribute('tabindex', '0');\n        this.style.cssText = 'padding:8px 16px;';\n      }\n    });\n  </script>\n</body>\n</html>\n",
