      "response": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Login</title>\n  <style>\n    body { margin: 0; font-family: system-ui, sans-serif; background: #f5f5f5; }\n    .login-wrap { display: flex; flex-direction: column; gap: 16px; max-width: 360px; margin: 80px auto; padding: 24px; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.12); }\n    h1 { font-size: 20px; margin: 0 0 4px; }\n    p { color: #666; margin: 0 0 8px; font-size: 14px; }\n    label { font-size: 13px; margin-top: 8px; }\n    bl-input { width: 100%; }\n    button { margin-top: 16px; padding: 10px 16px; background: #0057ff; color: #fff; border: none; border-radius: 6px; font-size: 15px; cursor: pointer; }\n    button:hover { background: #0043c4; }\n  </style>\n</head>\n<body>\n  <div class=\"login-wrap\">\n    <h1>Sign in</h1>\n    <p>Enter your credentials to continue.</p>\n\n    <label for=\"email\">Email address</label>\n    <bl-input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" required></bl-input>\n\n    <label for=\"password\">Password</label>\n    <bl-input id=\"password\" name=\"password\" type=\"password\" placeholder=\"••••••••\" required></bl-input>\n\n    <button id=\"login\">Sign in</button>\n  </div>\n\n  <script>\n    const form = document.querySelector('.login-wrap');\n    const btn = document.getElementById('login');\n    const enter = (e) => {\n      if (e.key === 'Enter') submit();\n    };\n    const submit = () => {\n      const email = document.getElementById('email').value;\n      const password = document.getElementById('password').value;\n      console.log('submitting', { email, password });\n    };\n    form.addEventListener('keydown', (e) => enter(e));\n    btn.addEventListener('click', submit);\n  </script>\n</body>\n</html>\n",
