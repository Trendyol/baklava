      "response": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Save Confirmation Toast</title>\n  <style>\n    body {\n      font-family: system-ui, sans-serif;\n      padding: 2rem;\n      display: flex;\n      flex-direction: column;\n      gap: 1.5rem;\n      align-items: flex-start;\n    }\n    .demo-heading { margin: 0; font-size: 1.1rem; }\n  </style>\n</head>\n<body>\n  <h1 class=\"demo-heading\">Save changes</h1>\n\n  <!-- The controller host that renders dismissible toast cards. -->\n  <bl-notification no-animation></bl-notification>\n\n  <bl-button id=\"save-btn\" variant=\"primary\">Save changes</bl-button>\n\n  <script type=\"module\">\n    const notification = document.querySelector('bl-notification');\n    const saveBtn = document.querySelector('bl-button#save-btn');\n\n    function showSavedToast() {\n      notification.addNotification({\n        caption: 'Success',\n        description: 'Your changes have been saved successfully.',\n        variant: 'success',\n        permanent: true,\n      });\n    }\n\n    saveBtn.addEventListener('bl-click', () => showSavedToast());\n\n    // Demonstrate the toast immediately on load.\n    showSavedToast();\n  </script>\n</body>\n</html>\n",
