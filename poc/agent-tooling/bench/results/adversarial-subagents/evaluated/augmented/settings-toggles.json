      "sample": 1,
      "response": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Settings</title>\n    <style>\n      body {\n        font-family: system-ui, -apple-system, sans-serif;\n        padding: 24px;\n        background: #fafafa;\n      }\n      .settings-list {\n        max-width: 520px;\n        display: flex;\n        flex-direction: column;\n        gap: 20px;\n        background: #fff;\n        border: 1px solid #e5e5e5;\n        border-radius: 8px;\n        padding: 20px 24px;\n      }\n      .setting-item {\n        display: flex;\n        flex-direction: column;\n        gap: 4px;\n      }\n      .helper {\n        font-size: 13px;\n        color: #666;\n        margin: 0;\n      }\n      .language-row {\n        display: flex;\n        align-items: flex-end;\n        gap: 16px;\n        justify-content: space-between;\n      }\n    </style>\n  </head>\n  <body>\n    <h1>Settings</h1>\n\n    <div class=\"settings-list\">\n      <!-- Material-Switch style toggles (real bl-switch, label via default slot) -->\n      <div class=\"setting-item\">\n        <bl-switch id=\"notifications\" checked>Enable notifications</bl-switch>\n        <p class=\"helper\">Get notified about new activity.</p>\n      </div>\n\n      <div class=\"setting-item\">\n        <bl-switch id=\"email\">Email digest</bl-switch>\n        <p class=\"helper\">Receive a weekly summary of your activity.</p>\n      </div>\n\n      <div class=\"setting-item\">\n        <bl-switch id=\"analytics\">Usage analytics</bl-switch>\n        <p class=\"helper\">Help us improve by sharing anonymous usage data.</p>\n      </div>\n\n      <!-- Language select (real bl-select + bl-select-option, helperText via help-text) -->\n      <div class=\"setting-item\">\n        <div class=\"language-row\">\n          <bl-select id=\"language\" label=\"Language\" placeholder=\"Select a language\" help-text=\"Choose your display language.\" size=\"medium\">\n            <bl-select-option value=\"tr\" label=\"Türkçe\"></bl-select-option>\n            <bl-select-option value=\"en\" label=\"English\" selected></bl-select-option>\n            <bl-select-option value=\"de\" label=\"Deutsch\"></bl-select-option>\n            <bl-select-option value=\"fr\" label=\"Français\"></bl-select-option>\n          </bl-select>\n        </div>\n      </div>\n    </div>\n\n    <script type=\"module\">\n      // Wire real bl-* events (no-op example wiring so interactions are live).\n      document.querySelectorAll('bl-switch').forEach((sw) => {\n        sw.addEventListener('bl-switch-toggle', (e) => {\n          e.target.setAttribute('aria-checked', String(e.detail === true));\n        });\n      });\n      document.querySelector('#language')?.addEventListener('bl-select', (e) => {\n        const val = Array.isArray(e.detail) ? e.detail[0]?.value : e.detail?.value;\n        console.log('language changed:', val);\n      });\n    </script>\n  </body>\n</html>\n",
